+/** Transforme un titre en identifiant d'ancre (pour les liens du sommaire) */
+export function ancreDe(titre: string) {
+  return titre
+    .toLowerCase()
+    .normalize("NFD")
+    .replace(/[\u0300-\u036f]/g, "")
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-|-$/g, "");
+}
