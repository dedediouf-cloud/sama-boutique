generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  shopName  String
  shopSlug  String   @unique
  phone     String?
  logoUrl   String?
  isBlocked Boolean  @default(false)
  subscriptionAmount Float    @default(0)
  subscriptionStatus String   @default("pending")
  subscriptionDueDate DateTime?
  lastPaidAt          DateTime?
  trialEndsAt         DateTime?
  trialUsed           Boolean  @default(false)
  billingInterval    String   @default("monthly")
  referralCode       String   @unique
  referredById     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products              Product[]
  customers             Customer[]
  sales                 Sale[]
  reservations          Reservation[]
  employees             Employee[]
  stockEntries          StockEntry[]
  deliveries            Delivery[]
  promotions            Promotion[]
  suppliers             Supplier[]
  supplierOrders        SupplierOrder[]
  inventoryCounts       InventoryCount[]
  subscriptionPayments  SubscriptionPayment[]
  referralRewards       ReferralReward[] @relation("ReferrerRewards")
  rewardsFrom           ReferralReward[] @relation("ReferredRewards")
  referredBy            User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referralsMade         User[]  @relation("UserReferrals")
  trialReminders        TrialReminder[]
  settings              BoutiqueSettings? @relation("UserToBoutiqueSettings")
  cashSessions          CashSession[]
}

model StockEntry {
  id        String   @id @default(cuid())
  quantity  Int
  note      String?
  createdAt DateTime @default(now())

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productId, createdAt])
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String
  password  String
  role      String   @default("seller")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  sales     Sale[]

  @@index([userId])
  @@index([email])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  quantity    Int      @default(0)
  lowStock    Int      @default(5)
  category    String?
  imageUrl    String?
  barcode     String?  @unique   // Code-barres EAN-13 / QR pour scan
  supplierId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // ✅ Relation nommée vers le fournisseur
  supplier Supplier? @relation("SupplierProducts", fields: [supplierId], references: [id])

  saleItems    SaleItem[]
  stockEntries StockEntry[]
  inventoryCounts InventoryCount[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, category])
}

model Customer {
  id             String    @id @default(cuid())
  name           String
  phone          String?
  address        String?
  email          String?
  fidelityPoints Int       @default(0)
  notes          String?
  dateOfBirth    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sales         Sale[]
  reservations  Reservation[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, fidelityPoints])
}

model Promotion {
  id          String    @id @default(cuid())
  code        String?   @unique
  name        String
  type        String
  value       Float
  minAmount   Float?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sales Sale[]

  @@index([userId])
  @@index([userId, active])
}

model Sale {
  id                  String   @id @default(cuid())
  total               Float
  discount            Float    @default(0)
  finalTotal          Float
  paymentMethod       String?  @default("cash")
  paymentStatus       String?  @default("pending")
  paymentRef          String?
  deliveryType        String?  @default("pickup")
  earnedFidelityPoints Int     @default(0)
  createdAt           DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id])

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  items         SaleItem[]
  transactions  PaymentTransaction[]
  delivery      Delivery?

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, paymentStatus])
  @@index([userId, customerId])
}

model PaymentTransaction {
  id        String   @id @default(cuid())
  provider  String
  amount    Float
  reference String?
  status    String   @default("pending")
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])
}

model Delivery {
  id            String   @id @default(cuid())
  status        String   @default("pending")
  address       String
  phone         String?
  notes         String?
  deliveryDate  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([saleId])
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orders   SupplierOrder[]
  // ✅ Relation inverse nommée (doit matcher exactement le nom dans Product)
  products Product[] @relation("SupplierProducts")

  @@index([userId])
}

model SupplierOrder {
  id           String   @id @default(cuid())
  status       String   @default("pending")
  total        Float
  orderDate    DateTime @default(now())
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items SupplierOrderItem[]

  @@index([userId])
  @@index([userId, createdAt])
}

model SupplierOrderItem {
  id          String  @id @default(cuid())
  productName String
  quantity    Int
  unitPrice   Float
  productId   String?

  supplierOrderId String
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id])
}

model Reservation {
  id            String   @id @default(cuid())
  productId     String?
  productName   String
  customerName  String
  customerPhone String?
  quantity      Int      @default(1)
  status        String   @default("pending")
  message       String?
  unitPrice     Float?     // prix unitaire (réservation simple)
  total         Float?     // montant total
  itemsData     String?    // JSON pour paniers groupés : [{"name":"...","quantity":2,"price":1500}]
  createdAt     DateTime @default(now())

  userId String
  user   User     @relation(fields: [userId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model SuperAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryCount {
  id            String   @id @default(cuid())
  countedQty    Int
  systemQty     Int
  difference    Int
  note          String?
  countedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  userId String
  user   User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SubscriptionPayment {
  id            String   @id @default(cuid())
  amount        Float
  discount      Float    @default(0)
  finalAmount   Float
  promotionId   String?
  promotionName String?
  periodStart   DateTime
  periodEnd     DateTime
  paidAt        DateTime @default(now())

  userId String
  user   User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, paidAt])
}

model SubscriptionPromotion {
  id              String   @id @default(cuid())
  name            String
  code            String?  @unique
  discountPercent Int?
  discountAmount  Float?
  monthsFree      Int        @default(0)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model GlobalSettings {
  id                         String   @id @default("default")
  annualSubscriptionDiscount Float    @default(0)
  referralRewardMonths       Int      @default(1)
  defaultMonthlyAmount       Float    @default(10000)
  trialDays                  Int      @default(15)
  updatedAt                  DateTime @updatedAt
}

model ReferralReward {
  id            String   @id @default(cuid())
  referrerId    String
  referredId    String
  monthsGranted Int
  createdAt     DateTime @default(now())

  referrer      User     @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  referred      User     @relation("ReferredRewards", fields: [referredId], references: [id], onDelete: Cascade)
}

model BoutiqueSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation("UserToBoutiqueSettings", fields: [userId], references: [id])

  // === PAIEMENTS MOBILES (par boutique) ===
  waveMerchantId      String?
  waveApiKey          String?
  waveSecret          String?

  omMerchantCode      String?
  omApiKey            String?
  omClientSecret      String?

  // Options générales
  paymentsEnabled     Boolean  @default(false)
  defaultPaymentMethod String? // "wave" | "orange_money" | "cash"
  merchantPhone       String? // numéro marchand si différent du phone principal

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CashSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])

  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  openingAmount  Float     @default(0)
  closingAmount  Float?
  expectedAmount Float?
  difference     Float?

  status         String    @default("OPEN") // OPEN | CLOSED
  note           String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sales          Sale[]

  @@index([userId])
  @@index([userId, openedAt])
  @@index([userId, status])
}

model TrialReminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // J5 | J1 | J0
  sentAt    DateTime @default(now())

  @@unique([userId, kind])
  @@index([userId])
}
